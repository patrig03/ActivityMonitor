<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:ActivityMonitor.ViewModels"
             xmlns:converters="clr-namespace:ActivityMonitor.Converters"
             x:Class="ActivityMonitor.Views.CategoriesView"
             x:DataType="viewModels:CategoriesViewModel">

  <UserControl.Resources>
    <converters:EqualsConverter x:Key="EqualsConverter"/>

    <DataTemplate x:Key="CategoryCardTemplate" DataType="viewModels:CategoryListItem">
      <Border Classes="panel-card panel-card--muted"
              Margin="0,0,0,8"
              Padding="16">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBlock Text="{Binding Name}"
                       FontSize="17"
                       FontWeight="Bold"
                       Foreground="{StaticResource BrushTextSecondary}"
                       TextWrapping="Wrap"/>
            <Border Grid.Column="1"
                    Classes="chip chip--overlay"
                    Padding="10,4">
              <TextBlock Text="{Binding UsageSummary}"
                         Foreground="{StaticResource BrushTextOnSoft}"
                         FontSize="11"
                         FontWeight="SemiBold"/>
            </Border>
          </Grid>
          <TextBlock Text="{Binding DescriptionPreview}"
                     Foreground="{StaticResource BrushTextMuted}"
                     TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="RuleCardTemplate" DataType="viewModels:CategoryRuleListItem">
      <Border Classes="panel-card panel-card--muted"
              Margin="0,0,0,8"
              Padding="16">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBlock Text="{Binding Title}"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="{StaticResource BrushTextSecondary}"
                       TextWrapping="Wrap"/>
            <Border Grid.Column="1"
                    Classes="chip chip--overlay"
                    Padding="10,4">
              <TextBlock Text="{Binding StatusLabel}"
                         Foreground="{StaticResource BrushTextOnSoft}"
                         FontSize="11"
                         FontWeight="SemiBold"/>
            </Border>
          </Grid>
          <TextBlock Text="{Binding Summary}"
                     Foreground="{StaticResource BrushTextMuted}"
                     FontSize="12"
                     TextWrapping="Wrap"/>
          <TextBlock Text="{Binding MatchPreview}"
                     Foreground="{StaticResource BrushTextPrimary}"
                     TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Panel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="20" Spacing="18">

        <Border Classes="page-hero">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="6">
              <TextBlock Text="Categorii" Classes="page-title"/>
              <TextBlock Text="{Binding PageSubtitle}" Classes="page-subtitle"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Button Command="{Binding OpenAddCategoryModalCommand}"
                      Classes="action-button success-button"
                      Content="Adaugă categorie"/>
              <Button Command="{Binding RefreshCommand}"
                      Classes="action-button subtle-button"
                      Content="Reîncarcă"/>
            </StackPanel>
          </Grid>
        </Border>

        <Border Classes="panel-card">
          <StackPanel Spacing="16">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBlock Text="Categorii existente" Classes="section-title"/>

              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Command="{Binding OpenEditCategoryModalCommand}"
                        IsEnabled="{Binding HasSelectedCategory}"
                        Classes="action-button subtle-button"
                        Content="Modifică"/>
                <Button Command="{Binding OpenDeleteCategoryModalCommand}"
                        IsEnabled="{Binding HasSelectedCategory}"
                        Classes="action-button warning-button"
                        Content="Șterge"/>
              </StackPanel>
            </Grid>

            <ListBox ItemsSource="{Binding Categories}"
                     SelectedItem="{Binding SelectedCategory}"
                     ItemTemplate="{StaticResource CategoryCardTemplate}"
                     Background="Transparent"
                     BorderThickness="0"
                     MaxHeight="360"/>
          </StackPanel>
        </Border>

        <Border Classes="panel-card"
                IsVisible="{Binding HasSelectedCategory}">
          <StackPanel Spacing="16">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBlock Text="{Binding SelectedCategory.Name, StringFormat='Reguli pentru {0}'}"
                         Classes="section-title"/>

              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Command="{Binding NewRuleCommand}"
                        Classes="action-button success-button"
                        Content="Regulă nouă"/>
                <Button Command="{Binding OpenEditRuleModalCommand}"
                        IsEnabled="{Binding HasSelectedCategoryRule}"
                        Classes="action-button subtle-button"
                        Content="Modifică"/>
                <Button Command="{Binding OpenDeleteRuleModalCommand}"
                        IsEnabled="{Binding HasSelectedCategoryRule}"
                        Classes="action-button warning-button"
                        Content="Șterge"/>
              </StackPanel>
            </Grid>

            <ListBox ItemsSource="{Binding CategoryRules}"
                     SelectedItem="{Binding SelectedCategoryRule}"
                     ItemTemplate="{StaticResource RuleCardTemplate}"
                     Background="Transparent"
                     BorderThickness="0"
                     MaxHeight="400"/>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <Border IsVisible="{Binding IsModalVisible}"
            Background="#8807111E"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
      <ScrollViewer VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    MaxHeight="820">
        <Border Classes="panel-card"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="640"
                MaxWidth="740"
                Margin="24"
                Padding="24">
          <StackPanel Spacing="18">

            <StackPanel IsVisible="{Binding ActiveModal, Converter={StaticResource EqualsConverter}, ConverterParameter=CategoryEditor}"
                        Spacing="18">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <TextBlock Text="{Binding CategoryEditorTitle}"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{StaticResource BrushTextSecondary}"/>
              </Grid>

              <TextBlock Text="{Binding CategoryEditorDescription}"
                         Classes="section-subtitle"
                         TextWrapping="Wrap"/>

              <StackPanel Spacing="8">
                <TextBlock Text="Nume categorie" Classes="field-label"/>
                <TextBox Text="{Binding CategoryDraftName}"
                         Watermark="Ex: Productivitate, Comunicare, Gaming"/>
              </StackPanel>

              <StackPanel Spacing="8">
                <TextBlock Text="Descriere" Classes="field-label"/>
                <TextBox Text="{Binding CategoryDraftDescription}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="120"
                         Watermark="Descrie pe scurt tipul de activitate sau criteriul de folosire."/>
              </StackPanel>

              <StackPanel Orientation="Horizontal"
                          HorizontalAlignment="Right"
                          Spacing="8">
                <Button Command="{Binding CloseModalCommand}"
                        Classes="action-button subtle-button"
                        Content="Anulează"/>
                <Button Command="{Binding SaveCategoryCommand}"
                        Classes="action-button success-button"
                        Content="Salvează categoria"/>
              </StackPanel>
            </StackPanel>

            <StackPanel IsVisible="{Binding ActiveModal, Converter={StaticResource EqualsConverter}, ConverterParameter=RuleEditor}"
                        Spacing="18">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <TextBlock Text="{Binding RuleEditorTitle}"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{StaticResource BrushTextSecondary}"
                           TextWrapping="Wrap"/>
                <Button Grid.Column="1"
                        Command="{Binding CloseModalCommand}"
                        Classes="action-button subtle-button"
                        Content="Închide"
                        Padding="12,8"/>
              </Grid>

              <TextBlock Text="{Binding RuleEditorDescription}"
                         Classes="section-subtitle"
                         TextWrapping="Wrap"/>

              <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <Border Classes="panel-card panel-card--muted"
                        Padding="16">
                  <StackPanel Spacing="12">
                    <TextBlock Text="Definiție" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>

                    <!-- <StackPanel Spacing="8"> -->
                    <!--   <TextBlock Text="Nume regulă" Classes="field-label"/> -->
                    <!--   <TextBox Text="{Binding RuleName}" -->
                    <!--            Watermark="Ex: Browser de lucru, Teams corporate"/> -->
                    <!-- </StackPanel> -->

                    <!-- <StackPanel Spacing="8"> -->
                    <!--   <TextBlock Text="Prioritate" Classes="field-label"/> -->
                    <!--   <TextBox Text="{Binding RulePriorityText}" -->
                    <!--            Watermark="Număr mic = evaluare mai devreme"/> -->
                    <!-- </StackPanel> -->

                    <StackPanel Spacing="8">
                      <TextBlock Text="Țintă" Classes="field-label"/>
                      <ComboBox ItemsSource="{Binding RuleTargetOptions}"
                                SelectedItem="{Binding SelectedRuleTarget}"/>
                    </StackPanel>

                    <StackPanel Spacing="8">
                      <TextBlock Text="Câmp verificat" Classes="field-label"/>
                      <ComboBox ItemsSource="{Binding RuleFieldOptions}"
                                SelectedItem="{Binding SelectedRuleField}"/>
                    </StackPanel>

                    <StackPanel Spacing="8">
                      <TextBlock Text="Potrivire" Classes="field-label"/>
                      <ComboBox ItemsSource="{Binding RuleMatchTypeOptions}"
                                SelectedItem="{Binding SelectedRuleMatchType}"/>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Classes="panel-card panel-card--muted"
                        Padding="16">
                  <StackPanel Spacing="12">
                    <TextBlock Text="Conținut regulă" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>

                    <StackPanel Spacing="8">
                      <TextBlock Text="Model de potrivire" Classes="field-label"/>
                      <TextBox Text="{Binding RulePattern}"
                               Watermark="Ex: slack, chrome.exe, JetBrains Rider, ^https://intranet\."/>
                    </StackPanel>

                    <WrapPanel Orientation="Horizontal">
                      <CheckBox IsChecked="{Binding RuleIgnoreCase}"
                                Content="Ignoră litere mari/mici"/>
                    </WrapPanel>

                    <!-- <StackPanel Spacing="8"> -->
                    <!--   <TextBlock Text="Note interne" Classes="field-label"/> -->
                    <!--   <TextBox Text="{Binding RuleNotes}" -->
                    <!--            AcceptsReturn="True" -->
                    <!--            TextWrapping="Wrap" -->
                    <!--            MinHeight="140" -->
                    <!--            Watermark="Opțional: de ce există regula sau ce variantă acoperă."/> -->
                    <!-- </StackPanel> -->
                  </StackPanel>
                </Border>
              </Grid>

              <Border Classes="panel-card panel-card--overlay"
                      Padding="14">
                <TextBlock Text="{Binding RulePreviewSummary}"
                           Foreground="{StaticResource BrushTextSecondary}"
                           TextWrapping="Wrap"/>
              </Border>

              <StackPanel Orientation="Horizontal"
                          HorizontalAlignment="Right"
                          Spacing="8">
                <Button Command="{Binding CloseModalCommand}"
                        Classes="action-button subtle-button"
                        Content="Anulează"/>
                <Button Command="{Binding SaveRuleCommand}"
                        Classes="action-button success-button"
                        Content="Salvează regula"/>
              </StackPanel>
            </StackPanel>

            <StackPanel IsVisible="{Binding ActiveModal, Converter={StaticResource EqualsConverter}, ConverterParameter=DeleteConfirm}"
                        Spacing="18">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <TextBlock Text="{Binding DeleteConfirmTitle}"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{StaticResource BrushTextSecondary}"/>
                <Button Grid.Column="1"
                        Command="{Binding CloseModalCommand}"
                        Classes="action-button subtle-button"
                        Content="Închide"
                        Padding="12,8"/>
              </Grid>

              <TextBlock Text="{Binding DeleteConfirmMessage}"
                         Foreground="{StaticResource BrushTextPrimary}"
                         TextWrapping="Wrap"/>

              <StackPanel Orientation="Horizontal"
                          HorizontalAlignment="Right"
                          Spacing="8">
                <Button Command="{Binding CloseModalCommand}"
                        Classes="action-button subtle-button"
                        Content="Anulează"/>
                <Button Command="{Binding ConfirmDeleteCommand}"
                        Classes="action-button danger-button"
                        Content="Șterge"/>
              </StackPanel>
            </StackPanel>

          </StackPanel>
        </Border>
      </ScrollViewer>
    </Border>
  </Panel>
</UserControl>
